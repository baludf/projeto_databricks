{
  "datasets": [
    {
      "name": "fato_vendas_filtrado",
      "displayName": "fato_vendas_filtrado",
      "queryLines": [
        "SELECT\n",
        "  CAST(data_pedido AS DATE) AS data_pedido,\n",
        "  CAST(ano AS INT) AS ano,\n",
        "  CAST(mes AS INT) AS mes,\n",
        "  canal,\n",
        "  CAST(pedido_id AS INT) AS pedido_id,\n",
        "  CAST(vendedor_id AS INT) AS vendedor_id,\n",
        "  CAST(cliente_id AS INT) AS cliente_id,\n",
        "  razao_social,\n",
        "  segmento,\n",
        "  cidade,\n",
        "  uf,\n",
        "  sku,\n",
        "  categoria,\n",
        "  marca,\n",
        "  nota_olfativa,\n",
        "  CAST(quantidade AS INT) AS quantidade,\n",
        "  CAST(preco_praticado AS DOUBLE) AS preco_praticado,\n",
        "  CAST(receita AS DOUBLE) AS receita,\n",
        "  CAST(custo AS DOUBLE) AS custo,\n",
        "  CAST(margem AS DOUBLE) AS margem,\n",
        "  devolucao,\n",
        "  CONCAT(LPAD(CAST(ano AS STRING), 4, '0'), '-', LPAD(CAST(mes AS STRING), 2, '0'), '-01') AS ano_mes_date\n",
        "FROM lakehouse_rotaperfume.gold.fato_vendas\n",
        "WHERE NOT devolucao\n"
      ]
    },
    {
      "name": "fila_semanal",
      "displayName": "fila_semanal",
      "queryLines": [
        "SELECT\n",
        "  vendedor,\n",
        "  CAST(ordem AS INT) AS ordem,\n",
        "  CAST(cliente_id AS INT) AS cliente_id,\n",
        "  razao_social,\n",
        "  cidade,\n",
        "  uf,\n",
        "  ROUND(score, 2) AS score,\n",
        "  faixa,\n",
        "  ROUND(ticket_medio, 2) AS ticket_medio,\n",
        "  motivo,\n",
        "  sugestao\n",
        "FROM lakehouse_rotaperfume.gold.fila_semanal\n"
      ]
    }
  ],
