  "sample_questions": [
    {
      "id": "f6a7b8c9d0e1f2a3b4c5d6a7b8c9d0e1",
      "question": "Quem eu ligo essa semana?",
      "sql": "SELECT vendedor, ordem, razao_social, ROUND(score, 2) AS nota, motivo, sugestao FROM lakehouse_rotaperfume.gold.fila_semanal ORDER BY score DESC LIMIT 20"
    },
    {
      "id": "a7b8c9d0e1f2a3b4c5d6a7b8c9d0e1f2",
      "question": "Quanto vale a fila desta semana?",
      "sql": "SELECT ROUND(SUM(score * ticket_medio), 2) AS receita_esperada FROM lakehouse_rotaperfume.gold.fila_semanal"
    },
    {
      "id": "b8c9d0e1f2a3b4c5d6a7b8c9d0e1f2a3",
      "question": "Quantas ligacoes ja foram registradas e quantas viraram pedido?",
      "sql": "SELECT COUNT(*) AS total_registros, SUM(CASE WHEN status = 'vendeu' THEN 1 ELSE 0 END) AS venderam FROM lakehouse_rotaperfume.gold.retorno_ligacao"
    },
    {
      "id": "c9d0e1f2a3b4c5d6a7b8c9d0e1f2a3b4",
      "question": "O modelo e bom?",
      "sql": "SELECT lift_top200, acertos_top200, ROUND(taxa_base * 100, 2) AS taxa_base_pct FROM lakehouse_rotaperfume.gold.modelo_metricas ORDER BY _treinado_em DESC LIMIT 1"
    },
    {
      "id": "d0e1f2a3b4c5d6a7b8c9d0e1f2a3b4c5",
      "question": "Quais clientes estao em risco de perda?",
      "sql": "SELECT razao_social, cidade, dias_sem_comprar, ROUND(ticket_medio, 2) AS ticket_medio FROM lakehouse_rotaperfume.gold.clientes_em_risco ORDER BY dias_sem_comprar DESC LIMIT 10"
    }
  ]
}
