  "sample_questions": [
    {
      "id": "a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6",
      "question": "Quem eu ligo essa semana?",
      "sql": "SELECT vendedor, ordem, razao_social, ROUND(score, 2) AS nota, motivo, sugestao FROM lakehouse_rotaperfume.gold.fila_semanal ORDER BY score DESC LIMIT 20"
    },
    {
      "id": "b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6a7",
      "question": "Quanto vale a fila desta semana?",
      "sql": "SELECT ROUND(SUM(score * ticket_medio), 2) AS receita_esperada FROM lakehouse_rotaperfume.gold.fila_semanal"
    },
    {
      "id": "c3d4e5f6a7b8c9d0e1f2a3b4c5d6a7b8",
      "question": "Qual a participacao de cada marca na receita?",
      "sql": "SELECT marca, ROUND(receita, 2) AS receita, ROUND(participacao_pct, 2) AS participacao_pct FROM lakehouse_rotaperfume.gold.ranking_marcas ORDER BY receita DESC"
    },
    {
      "id": "d4e5f6a7b8c9d0e1f2a3b4c5d6a7b8c9",
      "question": "Quais clientes nao compram ha mais de 90 dias?",
      "sql": "SELECT razao_social, cidade, uf, dias_sem_comprar, ROUND(ticket_medio, 2) AS ticket_medio FROM lakehouse_rotaperfume.gold.clientes_em_risco ORDER BY dias_sem_comprar DESC LIMIT 20"
    },
    {
      "id": "e5f6a7b8c9d0e1f2a3b4c5d6a7b8c9d0",
      "question": "Qual a taxa de ruptura por marca?",
      "sql": "SELECT marca, total_skus, em_ruptura, ROUND(pct_ruptura, 1) AS pct_ruptura FROM lakehouse_rotaperfume.gold.ruptura_por_marca ORDER BY pct_ruptura DESC"
    }
  ]
